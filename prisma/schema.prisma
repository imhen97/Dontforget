generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  nicknameSet  Boolean  @default(true)  // false면 가입 후 별명 미설정
  password     String?
  dailyGoal    Int      @default(5)
  streak       Int      @default(0)
  lastStudyDay String?  // ISO date string YYYY-MM-DD
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  nyang        Int      @default(30)  // 냥 (currency), start with 30냥
  equippedItems String  @default("{}") // JSON: {"hat":"hat_crown","accessory":"acc_glasses"}
  customTopics  String  @default("[]") // JSON: 사용자 추가 카테고리 이름 배열

  words        Word[]
  quizSessions QuizSession[]
  quizAnswers  QuizAnswer[]
  posts        Post[]
  comments     Comment[]
  postLikes    PostLike[]
  vocabLevel   VocabLevel?
  catItems     UserCatItem[]
  reviewNotes  ReviewNote[]
}

model UserCatItem {
  id        String   @id @default(cuid())
  userId    String
  itemId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
}

model Word {
  id          String   @id @default(cuid())
  userId      String
  word        String
  translation String
  exampleEn   String
  exampleKo   String?
  type        String   @default("word") // "word" | "phrase" | "idiom"
  topic       String?  @default("General")
  mastered    Boolean  @default(false)
  difficulty  Int      @default(3) // 1-6 scale (A1 to C2)
  phonetic    String?
  partOfSpeech String?
  examples    String?  // JSON array of {exampleEn, exampleKo}
  meanings    String?  // JSON array of meanings

  // SM-2 Spaced Repetition fields
  easeFactor  Float    @default(2.5)
  interval    Int      @default(1)   // days until next review
  repetitions Int      @default(0)
  nextReview  DateTime @default(now())

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizAnswers QuizAnswer[]
}

model QuizSession {
  id        String   @id @default(cuid())
  userId    String
  type      String   // "daily" | "weekly_wrong" | "random" | "topic"
  score     Int      @default(0)
  total     Int      @default(0)
  createdAt DateTime @default(now())

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers QuizAnswer[]
}

model QuizAnswer {
  id        String   @id @default(cuid())
  sessionId String
  wordId    String
  userId    String
  correct   Boolean
  quality   Int      @default(0) // 0-5 (SM-2 quality)
  createdAt DateTime @default(now())

  session QuizSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  word    Word        @relation(fields: [wordId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VocabLevel {
  id          String   @id @default(cuid())
  userId      String   @unique
  level       String   @default("Beginner") // Beginner/Elementary/Intermediate/Upper-Intermediate/Advanced/Proficient
  score       Float    @default(0)
  totalWords  Int      @default(0)
  percentile  Float    @default(0)
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Post {
  id        String   @id @default(cuid())
  userId    String
  title     String
  content   String
  category  String   @default("general") // "study_tips" | "word_debate" | "general"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments Comment[]
  likes    PostLike[]
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  content   String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PostLike {
  id     String @id @default(cuid())
  postId String
  userId String

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model ReviewNote {
  id        String   @id @default(cuid())
  userId    String
  title     String
  content   String
  summary   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
